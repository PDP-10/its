
TITLE COLOR TRIANGLE

A=1
B=2
C=3
D=4

TCOLOR:	CONO 420,40
	DATAI 420,D
	TRZ D,777740
	SETZ A,
TCOL1:	SETZ B,
TCOL2:	MOVEI C,20
	SUBI C,(A)
	LSH C,1
	TRZE C,20
	TRO C,17
	LSH C,5
	ADDI C,(A)
	SUBI C,(B)
	LSH C,1
	TRZE C,20
	TRO C,17
	LSH C,5
	IORI C,(B)
	HRLI C,(C)
	LSH C,1
	TRZE C,20
	TRO C,17
	TLNE D,400000
	ROT C,6
	TLNE D,200000
	ROT C,6
	CONO 420,202020(C)
	MOVEI C,(A)
	LSH C,11
	IORI C,(B)
	IMULI C,(D)
