
(LAP COLOR-OPEN SUBR)
(ARGS COLOR-OPEN (NIL . 0))
(DEFSYM ITEM 100)			;PLACE IN SLAVE TO PUT ITEMS
(DEFSYM ITEMNO 101)			;PLACE IN SLAVE TO GET BACK NUMBERS
(DEFSYM CSLAVE 102)			;STARTING ADDRESS OF SLAVE
(DEFSYM *RUNAME 4)
(DEFSYM *SUPC 400000)
(DEFSYM *SUSTP 400007)
	(CALL 0 (FUNCTION COLOR-CLOSE))	;TO OPEN, FIRST CLOSE!
COLOR0	(*OPEN SIXC (% SIXBIT / / &USR/ / / / / / PDP6))
	(JRST 0 COLOR1)			;FAILED TO OPEN PDP6 - TRY PDP10
	(*RESET SIXC)			;ZERO PDP6 MEMORY
	(MOVEI TT 1)			;1 MEANS PDP6
	(MOVEI B 'T)			;SO DOES T
	(JRST 0 COLOR2)
COLOR1	(MOVE D @ COLOR0)		;SET UP TO OPEN PDP10 SUBJOB
	(*SUSET 0 (% 0 0 R *RUNAME))
	(MOVE F (% SIXBIT CSLAVE))
	(*OPEN SIXC D)
	(JRST 0 COLOR6)			;FAILED TO OPEN PDP10
	(SETZB TT B)			;0, NIL MEAN PDP10
COLOR2	(*OPEN DSIC (% SIXBIT / / &SYSATSIGNCSLAVE))
	(JRST 0 COLOR7)			;FAILED TO FIND SLAVE FILE
	(*CALL 0 COLOR9)		;ELSE LOAD IT UP
	(JRST 0 COLOR8)
	(*CLOSE DSIC)
	(MOVE T (% 0 0 (400000 376000) (2400 SIXC)))
	(*CBLK T)			;MAP SLAVE INTO OUR HIGH CORE
	(*VALUE)
	(JUMPE TT COLOR4)		;JUMP IF PDP10
	(MOVE T (% JRST 0 CSLAVE))	;PDP6 SHOULD BE LOOPING IN 41
	(MOVEM T 774041)		;THIS WILL START UP THE SLAVE
	(MOVEI T 12)			;SHOULD START UP FAST - USE SHORT DELAY
COLOR3	(SKIPN 0 (774000 ITEM))		;SKIP UNLESS SLAVE ALIVE
	(JRST 0 COLOR5)
	(MOVEI D 1)
	(*SLEEP D)			;SLEEP 1/30. SECOND,
	(SOJG T COLOR3)			; THEN TRY AGAIN
	(SUBI TT 5)			;RETURN -4 IF PDP6 DEAD, -5 IF PDP10
	(JRST 0 FIX1)
COLOR4	(MOVEI T CSLAVE)		;THIS IS THE WAY TO START UP THE PDP10 SLAVE
	(*USET SIXC (% 0 0 T *SUPC))
	(*USET SIXC (% 0 0 R70 *SUSTP))
	(MOVEI T 144)
	(JRST 0 COLOR3)			;COULD TAKE FOREVER - USE LONG DELAY

COLOR5	(MOVEM B (SPECIAL COLOR-OPEN))	;FINALLY WON - SAVE STATUS
	(JRST 0 FIX1)			;T=PDP6, NIL=PDP10

COLOR6	(MOVNI TT 1)			;-1=FAILED TO GET PDP6 OR PDP10
	(JRST 0 FIX1)

COLOR7	(*UCLOSE SIXC)			;-2=FAILED TO OPEN SLAVE FILE ON SYS
	(MOVNI TT 2)
	(JRST 0 FIX1)

COLOR8	(*CLOSE DSIC)			;-3=FAILED TO LOAD UP SLAVE FILE
	(*UCLOSE SIXC)
	(MOVNI TT 3)
	(JRST 0 FIX1)

COLOR9	(SETZ)				;*CALL PARAMETERS FOR LOADING
	(SIXBIT LOAD)			; UP SLAVE FROM SYS FILE
	(0 0 (% SIXC))
	(SETZ 0 (% DSIC))

(ENTRY COLOR-CLOSE SUBR)
(ARGS COLOR-CLOSE (NIL . 0))
	(SKIPE T (SPECIAL COLOR-OPEN))
	(CAIN T 'T)
	(JRST 0 (* 2))
	(JRST 0 FALSE)			;RETURN NIL IF NOT OPEN
	(MOVEI A 'COLOR-OPEN)		;ELSE NOTE THAT IT'S CLOSED
	(CALL 1 (FUNCTION MAKUNBOUND))
	(*RESET SIXC)			;NOW CLOSE IT
	(*UCLOSE SIXC)
	(MOVEI T 376000)		;REMOVE PAGE FROM OUR CORE MAP
	(*CBLK T)
	(JFCL)
	(JRST 0 TRUE)			;FINALLY, RETURN T

FROB0	(ERINT 2 (% SIXBIT BAD/ ARG/ TO/ COLOR-FROB!))
(ENTRY COLOR-FROB SUBR)
(ARGS COLOR-FROB (NIL . 1))
	(SKIPE T (SPECIAL COLOR-OPEN))
	(CAIN T 'T)
	(JRST 0 FROB2)
	(CALL 1 (FUNCTION NCONS))	;CAN'T HAND OFF A COLOR
	(MOVEI B 'COLOR-FROB)		; FROB TO A NON-EXISTENT SLAVE
	(CALL 2 (FUNCTION XCONS))
	(ERINT 6 (% SIXBIT COLOR/ SLAVE/ NOT/ OPEN/ -/ COLOR-FROB!))
FROB2	(MOVEI B 0 A)			;CHECK OUT TYPE OF ARG
	(CALL 1 (FUNCTION TYPEP))
	(EXCH A B)
	(CAIE B 'FIXNUM)
	(JRST 0 FROB0)
	(JSP T FXNV1)
	(JUMPE TT FROB0)		;BETTER BE A NON-ZERO FIXNUM
	(SETZM 0 (774000 ITEMNO))	;CLEAR ITEMNO
	(MOVEM TT (774000 ITEM))	;HAND OFF ITEM TO SLAVE
	(MOVEI T 12)			;FOR PDP6 USE SHORT DELAY
	(SKIPN 0 (SPECIAL COLOR-OPEN))
	(MOVEI T 144)			;FOR PDP10 USE LONG DELAY
FROB4	(SKIPN 0 (774000 ITEM))		;SKIP UNLESS ITEM NOT GOBBLED YET
	(JRST 0 FROB7)
	(MOVEI D 1)			;SLEEP 1/30. SECOND
	(*SLEEP D)			; AND TRY AGAIN
	(SOJG T FROB4)			;IF WE FAIL WE'LL RETURN A ZERO
FROB7	(MOVE TT (774000 ITEMNO))	; ELSE WHATEVER THE SLAVE HANDS BACK
	(JRST 0 FIX1)
NIL 
