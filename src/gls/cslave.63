;;; SUPER HAIRY STRANGE BUFFERS FOR DISPLAY ITEMS AND ITEM NUMBERS.
;;; ITEMS ARE STORED ONE PER WORD IN CBUF. APTR INDICATES
;;; HOW MUCH OF CBUF IS BEING ACTIVELY SCANNED. NEW ITEMS ARE ADDED
;;; THE END OF THIS PORTION (WHERE APTR POINTS). AS ITEMS ARE DELETED,
;;; THE BUFFERS ARE COMPACTIFIED APPROPRIATELY. IBUF HELPS TO MAINTAIN
;;; THE CORRECT CORRESPONDENCE BETWEEN ITEMS AND ITEM NUMBERS IN THE
;;; FACE OF THIS COMPACTIFICATION: THE LEFT HALF OF IBUF(N) CONTAINS
;;; THE ITEM NUMBER FOR CBUF(N), WHILE CBUF(RIGHT HALF OF IBUF(N-1))
;;; CONTAINS THE ITEM FOR ITEM NUMBER N.

LBUFS==<20000-.>/2
CBUF:	BLOCK LBUFS
IBUF:	BLOCK LBUFS-1
	-1

SCREAM [BUFFER LENGTH = ]\LBUFS

END CSLAVE
