

;;*(SETQ BASE 8. IBASE 8.)


(SETQ BASE 10 IBASE 10) 

(SETQ PI 3.1415926 
      COLOR 313733 						       ;COLOR INITIALLY WHITE
      WHITE 313733 						       ;DEFINE OTHER COLORS
      PINK 312525 
      MAGENTA 370037 
      RED 370000 
      ORANGE 372700 
      YELLOW 363600 
      YELGRN 313700 
      GREEN 3700 
      BLUGRN 3730 
      BLUE 37 
      VIOLET 270037 
      BLACK 0) 

(DEFUN OPN NIL (COLOR-OPEN)) 					       ;OPEN SLAVE

(DEFUN CLS NIL (COLOR-CLOSE)) 					       ;CLOSE SLAVE

(DEFUN RESET NIL (COLOR-FROB -1)) 				       ;RESET SLAVE

(DEFUN XWD (X Y) (COLOR-FROB (+ (LSH (+ COLOR X) 22) Y))) 

(DEFUN IWD (X Y) (COLOR-FROB (+ (LSH X 22) Y))) 

(DEFUN CMD (X Y Z) (COLOR-FROB (+ (LSH X 36) (LSH Y 22) Z))) 

(DEFUN V (X Y) 							       ;RELATIVE VECTOR - SIGNED X,Y
       (XWD 404000 (+ (LSH (BOOLE 1 777 X) 11) (BOOLE 1 777 Y)))) 

(DEFUN P (X Y) 							       ;ABSOLUTE POINT - UNSIGNED X,Y
       (XWD 400000 (+ (LSH (BOOLE 1 777 X) 11) (BOOLE 1 777 Y)))) 

(DEFUN IP (X Y) 						       ;INVISIBLE ABS POINT (ALWAYS BLACK)
       (IWD 400000 (+ (LSH (BOOLE 1 777 X) 11) (BOOLE 1 777 Y)))) 

(DEFUN RP (X Y) 						       ;RELATIVE POINT - SIGNED X,Y
       (XWD 400040 (+ (LSH (BOOLE 1 777 X) 11) (BOOLE 1 777 Y)))) 

(DEFUN C (S X) 							       ;CHARACTER - S=SIZE, X=CHAR
       (XWD 404040
	    (+ (LSH S 11) (COND ((NUMBERP X)) ((CAR (EXPLODEN X))))))) 

(DEFUN GLOC (N) 						       ;GET LOC PORTION OF ITEM # N
       (BOOLE 1 777777 (CMD 1 N 0))) 

(DEFUN GCLR (N) 						       ;GET COLOR PORTION OF ITEM # N
       (BOOLE 1 777777 (CMD 2 N 0))) 

(DEFUN GDNS NIL 						       ;GET CURRENT DENSITY FACTOR
       (BOOLE 1 777777 (CMD 3 0 0))) 

(DEFUN DEL (N) (CMD 4 N 0)) 					       ;DELETE ITEM # N

(DEFUN MDEL (X) (MAPC (FUNCTION DEL) X)) 			       ;MOBY DEL

(DEFUN SLOC (N X) (CMD 5 N X)) 					       ;SET LOC PORTION OF ITEM # N

(DEFUN SCLR (N X) (CMD 6 N X)) 					       ;SET COLOR PORTION OF ITEM # N

(DEFUN SDNS (X) (CMD 7 0 X)) 					       ;SET VECTOR DENSITY FACTOR

(DEFUN BLINK (X N) 						       ;BLINK ITEM # XX, N TIMES
       (DO ((J (GCLR X)) (I 0 (1+ I)))
	   ((= I N))
	   (SCLR X 0)
	   (SLEEP 0.3)
	   (SCLR X J)
	   (SLEEP 0.3))) 

(DEFUN CLR (N) 							       ;SET STANDARD COLOR USED BY MOST FNS
       (SETQ COLOR (BOOLE 1 373737 N))) 

(DEFUN CIRCLE (R C) 						       ;DISPLAY CIRCLE OF RADIUS R, COLOR C
       (DO ((I (LIST ((LAMBDA (COLOR) (V R 0)) 0))
	       (CONS (RP (- (- X (SETQ X (FIX (TIMES R (COS A))))))
			 (- (- Y (SETQ Y (FIX (TIMES R (SIN A)))))))
		     I))
	    (DA (QUOTIENT (GDNS) (FLOAT R)))
	    (A 0.0 (+$ A DA))
	    (X R)
	    (Y 0)
	    (COLOR (OR C COLOR)))
	   ((> A (*$ 2.0 PI))
	    (CONS ((LAMBDA (COLOR) (V (- R) 0)) 0) I)))) 
