TITLE TVBUG

.MLLIT==1

F=0
A=1
B=2
C=3
D=4
E=5
P=17

ONCEFL==1	;DON'T WRAP AROUND - THIS IS LAST TIME THROUGH
EATFL==2	;EAT TEXT
WILDFL==4	;SUBLIMINAL JUMPS
BEGFL==10	;JUST BEGINNING TO WALK ON TO SCREEN

LPDL==20

GO:	TRO F,BEGFL
	MOVE P,[-LPDL,,PDL-1]
	MOVE A,[-11,,TVBEG_-12]
	MOVE B,[-11,,0]
	.CALL [ SETZ ? 'CORBLK
		1000,,600000		;READ/WRITE
		1000,,-1		;TARGET=ME
		A			;WHERE IN ME
		1000,,-2		;SOURCE=TV BUFFER
		SETZ B	]		;WHERE IN TV BUFFER
	.VALUE
	.VALUE [ASCIZ \:PROCED \]
	.RTIME A,
	ANDI A,7
	SETZ E,
LOOP:	MOVE B,BUGS(E)
	PUSHJ P,PUT
	MOVEI B,3
	.SLEEP B,
	MOVE B,BUGS(E)
	PUSHJ P,UNPUT
	TRNE F,WILDFL
	IMULI A,43.
	ADDI A,18.
	TRNE F,ONCEFL
	JRST LOOP1
	IDIVI A,440.*18.
	SKIPE A
	TRZ F,BEGFL
	MOVEI A,(B)
LOOP1:	ADDI E,1
	CAIL E,NBUGS
	SETZ E,
	CAIGE A,<440.+40.>*18.
	JRST LOOP
	.BREAK 16,160000

BUGS:	-LBUG,,BUG1
	-LBUG,,BUG2
	-LBUG,,BUG3
	-LBUG,,BUG4
NBUGS==.-BUGS

PUT:	MOVEI C,(A)
PUT1:	CAIGE C,440.*18.
	JRST PUT2
	TLNE F,ONCEFL
	JRST PUT3
PUT2:	MOVE D,(B)
	TRNN F,EATFL
	XORM D,TVBEG(C)
	TRNE F,EATFL
	IORM D,TVBEG(C)
PUT3:	SUBI C,18.
	JUMPGE C,PUT4
	TRNE F,BEGFL
	POPJ P,
	ADDI C,440.*18.
PUT4:	AOBJN B,PUT1
	POPJ P,

UNPUT:	MOVEI C,(A)
UNPUT1:	CAIGE C,440.*18.
	JRST UNPUT2
	TLNE F,ONCEFL
	JRST UNPUT3
UNPUT2:	MOVE D,(B)
	TRNN F,EATFL
	XORM D,TVBEG(C)
	TRNE F,EATFL
	ANDCAM D,TVBEG(C)
UNPUT3:	SUBI C,18.
	JUMPGE C,UNPUT4
	TRNE F,BEGFL
	POPJ P,
	ADDI C,440.*18.
UNPUT4:	AOBJN B,UNPUT1
	POPJ P,

